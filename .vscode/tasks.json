        "reveal": "always",
        "panel": "dedicated",
        "group": "transitlk",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "TransitLK: Mobile (Expo Go)",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\run.cmd",
      "args": [
        "mobile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "transitlk",
        "clear": true
