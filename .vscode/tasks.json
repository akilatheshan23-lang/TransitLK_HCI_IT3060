{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TransitLK: Backend",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\run.cmd",
      "args": [
        "backend"
      ],
      "options": {
