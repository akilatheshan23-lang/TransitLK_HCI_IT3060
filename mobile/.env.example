# Only needed for a standalone Android build. Expo Go works without your own key.
# Restrict to Maps SDK for Android, package lk.transit.mobile, and signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional iOS Google Maps provider configuration.
GOOGLE_MAPS_IOS_API_KEY=
# Geoapify API key for web map tiles, geocoding and live GPS tracking
EXPO_PUBLIC_GEOAPIFY_API_KEY=
