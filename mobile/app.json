{
  "expo": {
    "name": "TransitLK",
    "slug": "transitlk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "transitlk",
    "android": {
      "package": "lk.transit.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.transit.mobile"
    },
    "web": {
      "bundler": "metro",
      "name": "TransitLK"
    },
    "plugins": ["expo-secure-store"]
  }
}
